{
  "name": "jevway",
  "version": "0.1.1",
  "description": "Hand a browser goal to TypeSafe Jev; get a short verified summary back. MCP server + CLI.",
  "keywords": [
    "mcp",
    "mcp-server",
    "browser-automation",
    "chrome",
    "cdp",
    "jev",
    "typesafe",
    "agent",
    "claude-code"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Abdallah Othman",
  "homepage": "https://github.com/AbdallahAHO/jevway#readme",
  "bugs": {
    "url": "https://github.com/AbdallahAHO/jevway/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AbdallahAHO/jevway.git"
  },
  "bin": {
    "jevway": "dist/cli.js",
    "jevway-mcp": "dist/mcp.js"
  },
  "files": [
    "dist",
    "skill",
    "INSTALL-FOR-AGENTS.md",
    "LICENSE",
    "LICENSE.jev-ultrafast"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp src/browser/snapshot.js dist/browser/snapshot.js && chmod +x dist/cli.js dist/mcp.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm typecheck && pnpm test && rm -rf dist && pnpm build",
    "release": "node release/release.ts",
    "release:status": "node release/release.ts status",
    "release:check": "node release/release.ts check",
    "verify": "node --env-file-if-exists=.env verify/run.ts",
    "mcp": "node --env-file-if-exists=.env src/mcp.ts",
    "cli": "node --env-file-if-exists=.env src/cli.ts",
    "verify:reader": "node verify/reader.ts",
    "verify:journeys": "node --env-file-if-exists=.env verify/journeys.ts",
    "verify:real": "node --env-file-if-exists=.env verify/real-world.ts",
    "verify:langfuse": "node --env-file-if-exists=.env verify/langfuse.ts",
    "verify:grafana": "node --env-file-if-exists=.env verify/grafana.ts",
    "verify:checkout": "node --env-file-if-exists=.env verify/checkout.ts",
    "verify:redteam": "node --env-file-if-exists=.env verify/redteam.ts",
    "verify:gotchas": "node --env-file-if-exists=.env verify/gotchas.ts",
    "verify:capabilities": "node --env-file-if-exists=.env verify/capabilities.ts",
    "verify:forgejo": "node --env-file-if-exists=.env verify/forgejo.ts",
    "verify:signup": "node --env-file-if-exists=.env verify/signup.ts",
    "verify:vikunja": "node --env-file-if-exists=.env verify/vikunja.ts",
    "verify:agent": "node verify/agent.ts",
    "verify:replay": "node verify/replay.ts",
    "report:render": "node verify/jobs/rerender.ts",
    "apps:forgejo:up": "docker compose -p jevway-forgejo -f verify/apps/forgejo/compose.yml up -d --wait && node verify/apps/forgejo/seed.ts users",
    "apps:forgejo:down": "docker compose -p jevway-forgejo -f verify/apps/forgejo/compose.yml down -v",
    "apps:vikunja:up": "docker compose -p jevway-vikunja -f verify/apps/vikunja/compose.yml up -d --wait && node verify/apps/vikunja/seed.ts users",
    "apps:vikunja:down": "docker compose -p jevway-vikunja -f verify/apps/vikunja/compose.yml down -v"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@typesafe-ai/sdk": "^0.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
